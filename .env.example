# Application
APP_NAME=go-chi-boilerplate
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h

# Cache & Session (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Message Broker (NATS JetStream)
NATS_URL=nats://localhost:4222
NATS_CLUSTER_ID=
NATS_CLIENT_ID=go-chi-app

# Mail Delivery (SMTP / MailDev for local development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_NAME="Boilerplate Auth"

# Authentication & JWT
JWT_ACCESS_SECRET=your-256-bit-access-secret-change-in-production-min-32-chars!
JWT_REFRESH_SECRET=your-256-bit-refresh-secret-change-in-production-min-32-chars!
JWT_ISSUER=go-chi
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Login Throttler (Lockout Escalation)
LOGIN_THROTTLE_FAILURE_WINDOW=1h
LOGIN_THROTTLE_FIRST_LIMIT=5
LOGIN_THROTTLE_FIRST_BLOCK=30s
LOGIN_THROTTLE_SECOND_LIMIT=7
LOGIN_THROTTLE_SECOND_BLOCK=5m
LOGIN_THROTTLE_MAX_LIMIT=10
LOGIN_THROTTLE_MAX_BLOCK=15m

# Token Expirations & Frontend URLs
PASSWORD_RESET_TOKEN_TTL=15m
PASSWORD_RESET_URL=http://localhost:3000/reset-password
EMAIL_VERIFICATION_TOKEN_TTL=24h
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
EMAIL_CHANGE_TOKEN_TTL=1h
EMAIL_CHANGE_URL=http://localhost:3000/confirm-email

# Password Policy
PASSWORD_BCRYPT_COST=12

# Global Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LIMIT=100
RATE_LIMIT_WINDOW=1m

# S3 / Object Storage (MinIO for local development)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=boilerplate
STORAGE_USE_SSL=false
STORAGE_USE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/boilerplate
STORAGE_PRESIGN_EXPIRY=15m
STORAGE_TEMP_CLEANUP_INTERVAL=6h
STORAGE_TEMP_MAX_AGE=24h

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-CSRF-Token
CORS_EXPOSED_HEADERS=Link
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=300

# BASIC AUTH
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=admin
